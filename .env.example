# ---------------------------------------------------------------------------
# Whisk Flow — environment configuration
# Copy this file to .env.local. The app runs without any credentials using a
# local PGlite database, local file storage and local email/password accounts.
# ---------------------------------------------------------------------------

# Public app URL (used for auth redirects and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local auth secret. Required in production local mode (32+ random characters).
# If omitted in development, a secret is generated under .data/.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Supabase (production database + authentication + storage)
# 1. Create a Supabase project.
# 2. Apply supabase/migrations/0001_whisk_flow.sql.
# 3. Create a private storage bucket (default name: whisk-media).
# 4. Fill in the values below. DATABASE_URL is the direct Postgres connection
#    string and must stay server-only (never prefix it with NEXT_PUBLIC_).
# 5. In Supabase Dashboard > Authentication > URL Configuration:
#      Site URL:      http://localhost:3000 (or your production URL)
#      Redirect URLs: http://localhost:3000/auth/callback*
#                     https://your-domain/auth/callback*
#    Email confirmation and password reset links require these entries.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key used for storage uploads/signing and admin operations.
# Either name is accepted; SUPABASE_SECRET_KEY is preferred.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Storage bucket name (private). Defaults to whisk-media.
SUPABASE_STORAGE_BUCKET=whisk-media

# ---------------------------------------------------------------------------
# AI providers (optional). The product remains fully browsable without these.
# Generation is disabled honestly until at least one model provider is set.
# No provider key is ever exposed to the browser.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
# JSON2Video powers Whisk Flow 1.1, the 10-second text-led motion-graphics
# renderer. It is a rendering API, not a photoreal text-to-video model.
JSON2VIDEO_API_KEY=

# Optional model overrides. These defaults are current as of the catalog.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_TEXT_MODEL=gemini-3.8-flash
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_PRECISION_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-6-luna
JSON2VIDEO_MODEL=whisk-flow-1.1

# Optional app credit overrides. Credits are workspace units, not provider USD.
# JSON object mapping model IDs to credit costs.
# Image models charge per output; video models charge per second.
# CREDIT_COST_OVERRIDES={"gemini-nano-banana-2.1":10,"gemini-omni-1.1-flash":8,"whisk-flow-1.1":6,"gpt-image-2.5-flare":12,"gpt-image-2.5-sunburst":20}
CREDIT_COST_OVERRIDES=

# Optional upload limits (megabytes)
MAX_IMAGE_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Billing (optional)
#
# Billing has three modes:
#   stripe       STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are both set.
#                Checkout uses Stripe Checkout; orders are fulfilled by the
#                signature-verified webhook at /api/billing/webhook.
#   demo         Neither key is set AND this is a local workspace (no
#                DATABASE_URL and no Supabase configuration). Checkout is
#                simulated, clearly labelled, and no card is charged.
#   unconfigured Every other combination. The UI explains what is missing and
#                checkout returns 503 instead of pretending to charge.
#
# Demo mode is intentionally unavailable on a remote database so a public
# deployment cannot mint free credits. Prices and credit amounts live in
# lib/billing/plans.ts and are never accepted from the browser.
#
# Stripe setup:
# 1. No dashboard products are required — the app sends inline price_data
#    from the server-owned catalog in lib/billing/plans.ts.
# 2. Add a secret key below (a restricted key with Checkout, Billing Portal
#    and Subscription write access is enough).
# 3. Add the webhook endpoint https://your-domain/api/billing/webhook for
#    checkout.session.completed, checkout.session.expired, invoice.paid,
#    customer.subscription.updated and customer.subscription.deleted.
# 4. Copy the endpoint signing secret into STRIPE_WEBHOOK_SECRET.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Seeding (npm run db:seed)
# Local mode creates the account when it does not exist. In Supabase mode the
# profile must already exist (sign up in the app first).
# ---------------------------------------------------------------------------
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=
# "welcome" (two examples) or "demo" (welcome + demo projects). Default: demo.
SEED_SCOPE=
